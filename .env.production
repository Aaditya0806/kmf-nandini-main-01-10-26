# Non-secret build settings for production (safe to commit).
# Values set in Vercel → Settings → Environment Variables take priority over this file.
# Secrets (NEXT_PUBLIC_EMAIL / NEXT_PUBLIC_PASSWORD for the contact form) are NOT here:
# they already live in the Vercel project's environment variables.

# Strapi API (public; it is already visible in the site's browser code)
NEXT_PUBLIC_BASE_URL=https://m2kcctkzlf.execute-api.ap-south-1.amazonaws.com/prod

# "What brings you here today?" popup. To switch it off: set NEXT_PUBLIC_INTENT_POPUP=off
# in Vercel env vars (overrides this line) and redeploy.
NEXT_PUBLIC_INTENT_POPUP=on

# GA4 is G-164VVDS7P1 by default (src/lib/analytics.js); no setting needed.

# Ask Nandini chat assistant. To switch it off: set NEXT_PUBLIC_ASK_NANDINI=off in
# Vercel env vars (overrides this line) and redeploy. Its secrets (Claude and
# Supabase keys, admin password) are Vercel env vars only, never in this file.
NEXT_PUBLIC_ASK_NANDINI=on
